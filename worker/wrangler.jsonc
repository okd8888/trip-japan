{
  "name": "trip-sync",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  // The binding MUST be named DB - the Worker reads env.DB.
  // database_id is intentionally omitted so that Cloudflare provisions
  // a new database automatically (Deploy button / wrangler deploy).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trip-sync"
    }
  ],
  // Refresh cached exchange rates once a day (21:00 UTC = 05:00 Taipei).
  "triggers": {
    "crons": ["0 21 * * *"]
  }
}
